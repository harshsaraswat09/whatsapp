# Copy to .env for local dev. On Render, set these in the service's Environment tab.

# --- Required ---
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
GEMINI_API_KEY=

# --- Email (Gmail SMTP) ---
EMAIL_USER=
EMAIL_PASS=

# --- Optional ---
FRONTEND_URL=https://delegatex-frontend.onrender.com
WHATSAPP_SIMULATION_MODE=true
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
